# Copy to .env for local runs. Never commit .env; in AWS these come from Secrets Manager.
ENVIRONMENT=local
SECRET_KEY=replace-with-output-of-python-c-import-secrets-print-secrets-token-urlsafe-48
DATABASE_URL=postgresql+asyncpg://eduhub:eduhub@localhost:5432/eduhub
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Live contest leaderboards (sorted sets + pub/sub). Without it, the board falls back to DB polling.
REDIS_URL=redis://localhost:6379/0

# AI tutor via Amazon Bedrock (OpenAI-compatible endpoint).
AWS_BEARER_TOKEN_BEDROCK=
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
AWS_REGION=us-east-1
LLM_CHAT_MODEL=openai.gpt-oss-120b

# Semantic search: "hashing" (local, no network) or "bedrock" (Titan Text Embeddings v2, 512 dims).
EMBEDDING_PROVIDER=hashing
# Optional managed Bedrock Guardrail layered on top of the built-in checks.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Chapa payment gateway. Get keys from https://dashboard.chapa.co
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Server-to-server secret shared with the web app, which sends password-reset emails.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
