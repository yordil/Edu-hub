# Copy to deploy/.env.production on the server and fill in. Never commit the filled copy.
# There are deliberately no AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY lines: S3 credentials come
# from the EC2 instance's IAM role. See DEPLOYMENT_GUIDE.md, step 3.

# --- Public addresses ---
API_DOMAIN=api.example.com
API_PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=["https://your-app.vercel.app"]

# --- Core ---
ENVIRONMENT=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database: pick ONE ---
# (a) RDS / Aurora PostgreSQL 16 with pgvector:
# DATABASE_URL=postgresql+asyncpg://eduhub:PASSWORD@your-db.xxxxx.eu-central-1.rds.amazonaws.com:5432/eduhub
# (b) Postgres in a container on this instance (start compose with --profile localdb):
DATABASE_URL=postgresql+asyncpg://eduhub:CHANGE_ME@db:5432/eduhub
POSTGRES_PASSWORD=CHANGE_ME

REDIS_URL=redis://redis:6379/0

# --- Uploaded past papers ---
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
PAPER_UPLOADS_PER_HOUR=10
# OCR is CPU- and memory-heavy. Roughly one per vCPU; 2 suits a t3.medium.
WORKER_MAX_JOBS=2

# --- AI (Amazon Bedrock). Leave the key empty to run with the tutor disabled. ---
AWS_BEARER_TOKEN_BEDROCK=
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
LLM_CHAT_MODEL=openai.gpt-oss-120b
EMBEDDING_PROVIDER=hashing
AI_SCHOOL_MONTHLY_TOKEN_BUDGET=2000000
# One-time tutor trial per school without a plan. ~8,000 tokens per message; 0 disables it.
AI_FREE_TRIAL_TOKENS=10000

# --- Payments (Chapa) ---
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# --- Password resets ---
# Shared with the web app (same value in Vercel). It can mint reset tokens: keep it secret.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
PASSWORD_RESET_TTL_MINUTES=30
